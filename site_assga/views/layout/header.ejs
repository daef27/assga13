<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'ASSGA - Associação dos Surdos' %></title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <style>
        :root {
            --assga-blue: #003366;
            --assga-royal: #0056b3;
            --assga-yellow: #ffcc00;
            --assga-red: #c62828;
            --assga-light: #f8f9fa;
            --assga-dark: #212529;
        }
        body {
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            background-color: #f4f6f9;
        }
        .bg-assga-primary {
            background-color: var(--assga-blue) !important;
        }
        .text-assga-primary {
            color: var(--assga-blue) !important;
        }
        .bg-assga-yellow {
            background-color: var(--assga-yellow) !important;
        }
        .text-assga-yellow {
            color: var(--assga-yellow) !important;
        }
        .bg-assga-red {
            background-color: var(--assga-red) !important;
        }
        .border-assga-yellow {
            border-color: var(--assga-yellow) !important;
        }
        .border-assga-primary {
            border-color: var(--assga-blue) !important;
        }
        .navbar-assga {
            background: linear-gradient(90deg, #002244 0%, #003366 50%, #004080 100%);
            border-bottom: 4px solid var(--assga-yellow);
        }
        .navbar-brand img {
            height: 48px;
            width: auto;
            border-radius: 8px;
            margin-right: 12px;
            border: 2px solid #ffffff;
        }
        .nav-link {
            color: rgba(255, 255, 255, 0.9) !important;
            font-weight: 500;
            padding: 0.5rem 0.8rem !important;
            border-radius: 6px;
            transition: all 0.2s ease;
        }
        .nav-link:hover, .nav-link.active {
            color: var(--assga-yellow) !important;
            background-color: rgba(255, 255, 255, 0.1);
        }
        .footer-assga {
            background-color: #001f3f;
            color: #ffffff;
            border-top: 4px solid var(--assga-yellow);
            margin-top: auto;
        }
        .vlibras-badge {
            background: linear-gradient(135deg, #1976d2, #0d47a1);
            color: white;
            border-radius: 20px;
            padding: 4px 12px;
            font-size: 0.85rem;
            font-weight: bold;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            text-decoration: none;
        }
        .vlibras-badge:hover {
            color: #ffeb3b;
        }
        .admin-sidebar {
            min-height: calc(100vh - 160px);
            background: #ffffff;
            border-right: 1px solid #e0e0e0;
        }
        .admin-nav .nav-link {
            color: #495057 !important;
            border-radius: 8px;
            margin-bottom: 4px;
            font-weight: 500;
        }
        .admin-nav .nav-link:hover {
            background-color: #e9ecef;
            color: var(--assga-blue) !important;
        }
        .admin-nav .nav-link.active {
            background-color: var(--assga-blue) !important;
            color: #ffffff !important;
        }
        .ai-assistant-btn {
            position: fixed;
            bottom: 24px;
            right: 24px;
            z-index: 1050;
            box-shadow: 0 4px 15px rgba(0, 51, 102, 0.4);
            border: 2px solid var(--assga-yellow);
        }
        .high-contrast {
            background-color: #000000 !important;
            color: #ffffff !important;
        }
        .high-contrast .card {
            background-color: #121212 !important;
            color: #ffffff !important;
            border-color: #ffff00 !important;
        }
        .high-contrast .text-muted {
            color: #cccccc !important;
        }
        .high-contrast .navbar-assga {
            background: #000000 !important;
            border-bottom: 4px solid #ffff00 !important;
        }
        .high-contrast a {
            color: #ffff00 !important;
        }
    </style>
</head>
<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>">

    <!-- Top Bar de Utilidades e Acessibilidade -->
    <div class="bg-dark text-white py-1 px-3 border-bottom border-secondary small">
        <div class="container d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="d-flex align-items-center gap-3">
                <span><i class="fa-solid fa-hands-asl-interpreting text-warning me-1"></i> Acessibilidade em LIBRAS</span>
                <span class="d-none d-md-inline text-secondary">|</span>
                <span class="d-none d-md-inline"><i class="fa-solid fa-location-dot text-warning me-1"></i> São Gonçalo do Amarante - RN</span>
                <span class="d-none d-lg-inline text-secondary">|</span>
                <span class="d-none d-lg-inline">CNPJ: 57.242.499/0001-60</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button id="btnAumentarFonte" class="btn btn-sm btn-outline-light py-0 px-2" title="Aumentar Fonte" style="font-size: 0.75rem;">A+</button>
                <button id="btnDiminuirFonte" class="btn btn-sm btn-outline-light py-0 px-2" title="Diminuir Fonte" style="font-size: 0.75rem;">A-</button>
                <button id="btnContraste" class="btn btn-sm btn-outline-warning py-0 px-2" title="Alto Contraste" style="font-size: 0.75rem;">
                    <i class="fa-solid fa-circle-half-stroke"></i> Contraste
                </button>
                <a href="/idioma" class="vlibras-badge py-0 px-2" style="font-size: 0.75rem;">
                    <i class="fa-solid fa-hands"></i> LIBRAS
                </a>
            </div>
        </div>
    </div>

    <!-- Navegação Principal -->
    <nav class="navbar navbar-expand-lg navbar-dark navbar-assga sticky-top shadow-sm py-2">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center" href="/">
                <img src="/imagens/Assga_foto.jpg" alt="Logo da ASSGA">
                <span class="fw-bold text-white fs-3">ASSGA</span>
                <span class="d-none d-md-inline text-white-50 fs-6 border-start ps-2">Portal dos Surdos</span>
            </a>
            
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarContent">
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-lg-center gap-1">
                    <li class="nav-item">
                        <a class="nav-link <%= activePage === 'home' ? 'active' : '' %>" href="/"><i class="fa-solid fa-house me-1"></i> Início</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%= activePage === 'historia' ? 'active' : '' %>" href="/historia"><i class="fa-solid fa-book-open me-1"></i> História</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%= activePage === 'estatuto' ? 'active' : '' %>" href="/estatuto"><i class="fa-solid fa-scale-balanced me-1"></i> Estatuto</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%= activePage === 'diretoria' ? 'active' : '' %>" href="/diretoria"><i class="fa-solid fa-users me-1"></i> Diretoria</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%= activePage === 'esportiva' ? 'active' : '' %>" href="/esportiva"><i class="fa-solid fa-futbol me-1"></i> Esportes</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%= activePage === 'evento' ? 'active' : '' %>" href="/eventos"><i class="fa-solid fa-calendar me-1"></i> Eventos</a>
                    </li>

                    <% if (user) { %>
                    <li class="nav-item">
                        <a class="nav-link <%= activePage === 'carteirinha' ? 'active' : '' %>" href="/carteirinha"><i class="fa-solid fa-id-card me-1"></i> Carteirinha</a>
                    </li>
                    <li class="nav-item ms-lg-2">
                        <a class="btn btn-warning btn-sm fw-bold" href="/area-associado"><i class="fa-solid fa-user-check me-1"></i> <%= user.nome.split(' ')[0] %></a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-warning" href="/logout" title="Sair"><i class="fa-solid fa-arrow-right-from-bracket"></i></a>
                    </li>
                    <% } else { %>
                    <li class="nav-item ms-lg-2">
                        <a class="btn btn-outline-light btn-sm px-3 rounded-pill fw-bold" href="/login"><i class="fa-solid fa-right-to-bracket me-1"></i> Entrar</a>
                    </li>
                    <% } %>
                    <% const isAdminView = String(typeof bodyClass !== 'undefined' && bodyClass ? bodyClass : '').includes('admin-theme') || String(typeof activePage !== 'undefined' && activePage ? activePage : '').startsWith('admin'); %>
                    <% if (!isAdminView) { %>
                    <% } %>
                </ul>
            </div>
        </div>
    </nav>

    <% if (typeof messages !== 'undefined' && messages) { %>
        <div class="container mt-3">
            <% if (messages.success) { %>
                <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                    <i class="fa-solid fa-circle-check me-2"></i> <%= messages.success %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            <% } %>
            <% if (messages.error) { %>
                <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i> <%= messages.error %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            <% } %>
            <% if (messages.info) { %>
                <div class="alert alert-info alert-dismissible fade show shadow-sm" role="alert">
                    <i class="fa-solid fa-circle-info me-2"></i> <%= messages.info %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            <% } %>
        </div>
    <% } %>

    <main class="flex-grow-1 py-4">
