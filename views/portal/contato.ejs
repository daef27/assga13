<%- include('../layout/header') %>

<div class="container py-4">
    <!-- Cabeçalho da Seção -->
    <div class="p-4 p-md-5 mb-4 rounded-4 text-white shadow-sm" style="background: linear-gradient(135deg, #0a2f63 0%, #0d4aa4 50%, #1b6de2 100%);">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold mb-3">
                    <i class="fa-solid fa-headset me-1"></i> Atendimento &amp; Comunicação
                </span>
                <h1 class="display-6 fw-bold mb-2">¤ CONTATO</h1>
                <h4 class="fw-semibold text-warning mb-3">* Fale Conosco</h4>
                <p class="lead text-light opacity-90 mb-0">
                    Envie sua mensagem, dúvida, sugestão ou solicitação para a diretoria da ASSGA. Atendemos a comunidade surda, atletas, parceiros e ouvintes com acessibilidade plena em LIBRAS.
                </p>
            </div>
            <div class="col-lg-4 text-center mt-4 mt-lg-0">
                <div class="card border-0 bg-white text-dark p-3 rounded-4 shadow">
                    <div class="d-flex align-items-center justify-content-center gap-2 mb-2">
                        <span class="fs-4">🤟</span>
                        <h6 class="fw-bold text-primary mb-0">Atendimento em LIBRAS</h6>
                    </div>
                    <p class="small text-muted mb-2">Chamadas de vídeo e mensagens diretas pelo WhatsApp da associação.</p>
                    <a href="https://wa.me/5584996981248" target="_blank" class="btn btn-success btn-sm fw-bold rounded-pill">
                        <i class="fa-brands fa-whatsapp me-1"></i> Iniciar Conversa
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Formulário Fale Conosco -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white h-100">
                <div class="d-flex align-items-center gap-2 mb-4 pb-2 border-bottom">
                    <div class="bg-primary text-white rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                        <i class="fa-solid fa-envelope"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold text-primary mb-0">Fale Conosco</h4>
                        <span class="text-muted small">Preencha os dados abaixo para enviar sua mensagem</span>
                    </div>
                </div>

                <form method="post" action="/contato">
                    <!-- Nome ( seu nome completo ) -->
                    <div class="mb-3">
                        <label for="nomeContato" class="form-label fw-bold text-dark">
                            <i class="fa-solid fa-user me-1 text-primary"></i> Nome <span class="text-muted fw-normal">( seu nome completo )</span>
                        </label>
                        <input type="text" id="nomeContato" name="nome" class="form-control form-control-lg rounded-3 fs-6" placeholder="Seu nome completo" required>
                    </div>

                    <div class="row g-3 mb-3">
                        <!-- E-mail ( seu@email.com ) -->
                        <div class="col-md-6">
                            <label for="emailContato" class="form-label fw-bold text-dark">
                                <i class="fa-solid fa-at me-1 text-primary"></i> E-mail <span class="text-muted fw-normal">( seu@email.com )</span>
                            </label>
                            <input type="email" id="emailContato" name="email" class="form-control form-control-lg rounded-3 fs-6" placeholder="seu@email.com" required>
                        </div>

                        <!-- Telefone/celular (84)9999-0000 -->
                        <div class="col-md-6">
                            <label for="telefoneContato" class="form-label fw-bold text-dark">
                                <i class="fa-solid fa-phone me-1 text-primary"></i> Telefone/celular <span class="text-muted fw-normal">(84) 9999-0000</span>
                            </label>
                            <input type="tel" id="telefoneContato" name="telefone" class="form-control form-control-lg rounded-3 fs-6" placeholder="(84) 9999-0000" required>
                        </div>
                    </div>

                    <!-- Mensagem ( Escreva sua mensagem aqui..) -->
                    <div class="mb-4">
                        <label for="mensagemContato" class="form-label fw-bold text-dark">
                            <i class="fa-solid fa-comment-dots me-1 text-primary"></i> Mensagem <span class="text-muted fw-normal">( Escreva sua mensagem aqui.. )</span>
                        </label>
                        <textarea id="mensagemContato" name="mensagem" rows="5" class="form-control form-control-lg rounded-3 fs-6" placeholder="Escreva sua mensagem aqui.." required></textarea>
                        <div class="form-text">
                            Informe sua dúvida, interesse desportivo, solicitação de filiação ou proposta para a ASSGA.
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg fw-bold rounded-pill py-3 shadow-sm">
                            <i class="fa-solid fa-paper-plane me-2"></i> Enviar Mensagem
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Canais e Informações Oficiais -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                <h5 class="fw-bold text-primary mb-3">
                    <i class="fa-solid fa-address-book me-2"></i>Canais Oficiais da ASSGA
                </h5>
                <ul class="list-unstyled d-grid gap-3 mb-0">
                    <li class="d-flex align-items-start gap-3 p-3 rounded-3" style="background-color: #f6fbff;">
                        <div class="bg-success text-white rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                            <i class="fa-brands fa-whatsapp fs-5"></i>
                        </div>
                        <div>
                            <div class="fw-bold text-dark">WhatsApp Oficial (LIBRAS &amp; Texto)</div>
                            <a href="https://wa.me/5584996981248" target="_blank" class="text-success text-decoration-none fw-semibold">(84) 99698-1248</a>
                            <div class="small text-muted">Atendimento prioritário em Língua de Sinais e mensagens escritas.</div>
                        </div>
                    </li>

                    <li class="d-flex align-items-start gap-3 p-3 rounded-3" style="background-color: #f6fbff;">
                        <div class="bg-primary text-white rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                            <i class="fa-solid fa-envelope fs-5"></i>
                        </div>
                        <div>
                            <div class="fw-bold text-dark">E-mail Institucional</div>
                            <a href="mailto:assgar2019@gmail.com" class="text-primary text-decoration-none fw-semibold">assgar2019@gmail.com</a>
                            <div class="small text-muted">Para ofícios, convites esportivos e documentações oficiais.</div>
                        </div>
                    </li>

                    <li class="d-flex align-items-start gap-3 p-3 rounded-3" style="background-color: #f6fbff;">
                        <div class="bg-warning text-dark rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                            <i class="fa-solid fa-location-dot fs-5"></i>
                        </div>
                        <div>
                            <div class="fw-bold text-dark">Sede e Atuação</div>
                            <div class="text-secondary fw-semibold">São Gonçalo do Amarante - RN</div>
                            <div class="small text-muted">Treinos no Ginásio Municipal e encontros na comunidade.</div>
                        </div>
                    </li>

                    <li class="d-flex align-items-start gap-3 p-3 rounded-3" style="background-color: #f6fbff;">
                        <div class="bg-danger text-white rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                            <i class="fa-solid fa-id-badge fs-5"></i>
                        </div>
                        <div>
                            <div class="fw-bold text-dark">Cadastro Nacional</div>
                            <div class="text-secondary fw-semibold">CNPJ: 57.242.499/0001-60</div>
                            <div class="small text-muted">Entidade sem fins lucrativos fundada em 23/07/2024.</div>
                        </div>
                    </li>
                </ul>
            </div>

            <!-- Chamada para Ser Voluntário -->
            <div class="card border-0 shadow-sm rounded-4 p-4 text-white" style="background: linear-gradient(135deg, #198754 0%, #10633c 100%);">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="fs-4">🤝</span>
                    <h5 class="fw-bold mb-0">Faça a Diferença</h5>
                </div>
                <p class="small text-light opacity-90 mb-3">
                    Você tem interesse em apoiar os eventos esportivos, treinos de futsal ou projetos culturais da comunidade surda?
                </p>
                <a href="/voluntario" class="btn btn-warning fw-bold text-dark rounded-pill">
                    <i class="fa-solid fa-hand-holding-heart me-1"></i> Quero Ser Voluntário
                </a>
            </div>
        </div>
    </div>
</div>

<%- include('../layout/footer') %>
