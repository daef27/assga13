<%- include('../layout/header') %>

<div class="container py-4">
    <!-- Banner Principal -->
    <div class="p-4 p-md-5 mb-4 rounded-4 text-white shadow-sm" style="background: linear-gradient(135deg, #10633c 0%, #198754 50%, #20c997 100%);">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold mb-3">
                    <i class="fa-solid fa-heart-pulse me-1"></i> Movimento de Inclusão &amp; Cidadania
                </span>
                <h1 class="display-6 fw-bold mb-2">¤ SEJA UM VOLUNTÁRIO</h1>
                <h4 class="fw-semibold text-warning mb-3">Você também pode fazer parte deste movimento!</h4>
                <p class="lead text-light opacity-90 mb-0">
                    A Associação dos Surdos de São Gonçalo do Amarante (ASSGA) convida voluntários surdos e ouvintes, estudantes de Letras LIBRAS, educadores físicos e membros da comunidade para fortalecerem nossos treinos desportivos, eventos e ações culturais.
                </p>
            </div>
            <div class="col-lg-4 text-center mt-4 mt-lg-0">
                <div class="card border-0 bg-white text-dark p-3 rounded-4 shadow">
                    <span class="display-5 mb-2">🤟⚽</span>
                    <h6 class="fw-bold text-success mb-1">Voluntariado Inclusivo</h6>
                    <p class="small text-muted mb-0">Aprenda e pratique LIBRAS no dia a dia enquanto apoia nossos atletas e projetos.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Formulário: QUERO SER VOLUNTÁRIO -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white h-100">
                <div class="d-flex align-items-center gap-3 mb-4 pb-2 border-bottom">
                    <div class="bg-success text-white rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 46px; height: 46px;">
                        <i class="fa-solid fa-handshake-angle fs-5"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold text-success mb-0">&quot; QUERO SER VOLUNTÁRIO &quot;</h4>
                        <span class="text-muted small">Preencha sua ficha cadastral para integrar a equipe de voluntários da ASSGA</span>
                    </div>
                </div>

                <form method="post" action="/voluntario">
                    <!-- □NOME COMPLETO : -->
                    <div class="mb-3">
                        <label for="nomeVoluntario" class="form-label fw-bold text-dark">
                            <span class="text-success me-1">□</span> NOME COMPLETO :
                        </label>
                        <input type="text" id="nomeVoluntario" name="nome" class="form-control form-control-lg rounded-3 fs-6" placeholder="Digite seu nome completo" required>
                    </div>

                    <!-- □E-MAIL : -->
                    <div class="mb-3">
                        <label for="emailVoluntario" class="form-label fw-bold text-dark">
                            <span class="text-success me-1">□</span> E-MAIL :
                        </label>
                        <input type="email" id="emailVoluntario" name="email" class="form-control form-control-lg rounded-3 fs-6" placeholder="seu@email.com" required>
                    </div>

                    <div class="row g-3 mb-3">
                        <!-- □ SEU TELEFONE: -->
                        <div class="col-md-7">
                            <label for="telefoneVoluntario" class="form-label fw-bold text-dark">
                                <span class="text-success me-1">□</span> SEU TELEFONE :
                            </label>
                            <input type="tel" id="telefoneVoluntario" name="telefone" class="form-control form-control-lg rounded-3 fs-6" placeholder="(84) 99999-0000" required>
                        </div>

                        <!-- □ SUA IDADE -->
                        <div class="col-md-5">
                            <label for="idadeVoluntario" class="form-label fw-bold text-dark">
                                <span class="text-success me-1">□</span> SUA IDADE :
                            </label>
                            <input type="number" id="idadeVoluntario" name="idade" min="14" max="100" class="form-control form-control-lg rounded-3 fs-6" placeholder="Ex: 24" required>
                        </div>
                    </div>

                    <!-- MESSAGE: ( TEXTO) -->
                    <div class="mb-4">
                        <label for="mensagemVoluntario" class="form-label fw-bold text-dark">
                            <i class="fa-solid fa-pen-nib me-1 text-success"></i> MESSAGE : <span class="text-muted fw-normal">( TEXTO )</span>
                        </label>
                        <textarea id="mensagemVoluntario" name="mensagem" rows="5" class="form-control form-control-lg rounded-3 fs-6" placeholder="Escreva como você gostaria de atuar como voluntário (ex: suporte em treinos de futsal, eventos comemorativos, registro fotográfico, mediação com famílias, auxílio administrativo, etc.).." required></textarea>
                        <div class="form-text">
                            Conte-nos se você já conhece a Língua Brasileira de Sinais (LIBRAS) ou se deseja aprender com nossos associados.
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-success btn-lg fw-bold rounded-pill py-3 shadow-sm">
                            <i class="fa-solid fa-heart me-2"></i> QUERO SER VOLUNTÁRIO
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Áreas de Atuação e Benefícios do Voluntariado -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                <h5 class="fw-bold text-success mb-3">
                    <i class="fa-solid fa-list-check me-2"></i>Áreas de Atuação Voluntária
                </h5>
                <div class="d-grid gap-3">
                    <div class="d-flex align-items-start gap-3 p-3 rounded-3" style="background-color: #f3faf6;">
                        <div class="bg-success text-white rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                            <i class="fa-solid fa-futbol"></i>
                        </div>
                        <div>
                            <div class="fw-bold text-dark">Apoio aos Treinos Desportivos</div>
                            <div class="small text-muted">Apoio nas atividades de futsal, voleibol e atletismo, hidratação, súmulas visuais e cronometragem.</div>
                        </div>
                    </div>

                    <div class="d-flex align-items-start gap-3 p-3 rounded-3" style="background-color: #f3faf6;">
                        <div class="bg-primary text-white rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                            <i class="fa-solid fa-hands-asl-interpreting"></i>
                        </div>
                        <div>
                            <div class="fw-bold text-dark">Prática e Imersão em LIBRAS</div>
                            <div class="small text-muted">Oportunidade única para estudantes de Letras LIBRAS e intérpretes em formação praticarem com a comunidade nativa.</div>
                        </div>
                    </div>

                    <div class="d-flex align-items-start gap-3 p-3 rounded-3" style="background-color: #f3faf6;">
                        <div class="bg-warning text-dark rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                            <i class="fa-solid fa-camera"></i>
                        </div>
                        <div>
                            <div class="fw-bold text-dark">Comunicação e Audiovisual</div>
                            <div class="small text-muted">Fotografia, vídeos para redes sociais, produção de conteúdo visual acessível para a comunidade.</div>
                        </div>
                    </div>

                    <div class="d-flex align-items-start gap-3 p-3 rounded-3" style="background-color: #f3faf6;">
                        <div class="bg-danger text-white rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                            <i class="fa-solid fa-cake-candles"></i>
                        </div>
                        <div>
                            <div class="fw-bold text-dark">Eventos e Confraternizações</div>
                            <div class="small text-muted">Organização de eventos como o Halloween ASSGA, Setembro Azul, torneios regionais e comemorações.</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4 p-4 text-white" style="background: linear-gradient(135deg, #0d3d8f 0%, #1a63d0 100%);">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="fa-solid fa-certificate text-warning fs-4"></i>
                    <h5 class="fw-bold mb-0">Certificado de Voluntariado</h5>
                </div>
                <p class="small text-light opacity-90 mb-3">
                    A ASSGA emite declaração e certificado oficial de horas complementares de atividade voluntária para universitários e profissionais.
                </p>
                <div class="small bg-white bg-opacity-10 p-2 rounded-3">
                    <i class="fa-solid fa-shield-halved text-warning me-1"></i> Entidade com CNPJ 57.242.499/0001-60 em São Gonçalo do Amarante - RN.
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../layout/footer') %>
