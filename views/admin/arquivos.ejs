<%- include('../layout/header') %>

<div class="container py-4">
    <!-- Breadcrumb e Título -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <span class="badge bg-primary px-3 py-1 rounded-pill fw-bold text-uppercase small">PostgreSQL Cloud SQL</span>
            <h2 class="fw-bold text-primary mb-1 mt-1"><i class="fa-solid fa-database text-warning me-2"></i>Arquivos & Uploads no Banco SQL</h2>
            <p class="text-muted small mb-0">Tabela <code>arquivos</code> mapeada no PostgreSQL com integridade de armazenamento físico em disco</p>
        </div>
        <a href="/admin" class="btn btn-outline-secondary rounded-pill fw-semibold btn-sm">
            <i class="fa-solid fa-arrow-left me-1"></i> Voltar ao Painel
        </a>
    </div>

    <!-- Navegação de Abas do Admin -->
    <%- include('nav_tabs') %>

    <!-- Alertas -->
    <% if (messages && messages.length > 0) { %>
        <% messages.forEach(function(msg) { %>
            <div class="alert alert-<%= msg.type %> alert-dismissible fade show rounded-3 shadow-sm" role="alert">
                <i class="fa-solid fa-circle-info me-2"></i> <%= msg.text %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% }); %>
    <% } %>

    <!-- Card de Boas Práticas de Upload -->
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
        <div class="row align-items-center g-3">
            <div class="col-md-8">
                <h5 class="fw-bold text-primary mb-1"><i class="fa-solid fa-shield-halved text-success me-2"></i>Arquitetura Segura de Uploads (SQL + Disco)</h5>
                <p class="text-muted small mb-0">
                    Conforme as melhores práticas, o arquivo binário <strong>nunca é salvo dentro do SQL</strong>. Ele é gravado no disco com nome sanitizado e timestamp único, e os metadados (caminho, tamanho, tipo MIME e vínculo com usuário) ficam registrados com segurança na tabela relacional PostgreSQL.
                </p>
            </div>
            <div class="col-md-4 text-md-end">
                <span class="badge bg-success-subtle text-success border border-success px-3 py-2 rounded-pill fw-bold">
                    <i class="fa-solid fa-check-double me-1"></i> Total de Arquivos no SQL: <%= arquivosList.length %>
                </span>
            </div>
        </div>
    </div>

    <!-- Tabela de Arquivos -->
    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
        <div class="table-responsive">
            <table class="table table-hover align-middle small mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 60px;">ID</th>
                        <th style="width: 80px;">Prévia</th>
                        <th>Nome do Arquivo</th>
                        <th>Caminho Gravado no SQL</th>
                        <th>Tamanho</th>
                        <th>Tipo MIME</th>
                        <th>Registrado em</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (arquivosList && arquivosList.length > 0) { %>
                        <% arquivosList.forEach(function(arq) { %>
                            <tr>
                                <td class="fw-bold text-muted">#<%= arq.id %></td>
                                <td>
                                    <% if (arq.caminho && (arq.caminho.endsWith('.jpg') || arq.caminho.endsWith('.jpeg') || arq.caminho.endsWith('.png') || arq.caminho.endsWith('.svg') || arq.caminho.endsWith('.webp'))) { %>
                                        <img src="<%= arq.caminho %>" alt="<%= arq.nomeArquivo %>" class="rounded border" style="width: 44px; height: 44px; object-fit: cover;">
                                    <% } else { %>
                                        <div class="bg-light text-secondary rounded d-flex align-items-center justify-content-center border" style="width: 44px; height: 44px;">
                                            <i class="fa-solid fa-file-lines"></i>
                                        </div>
                                    <% } %>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark"><%= arq.nomeArquivo %></div>
                                    <% if (arq.usuarioId) { %>
                                        <span class="badge bg-light text-primary border font-monospace">Usuário #<%= arq.usuarioId %></span>
                                    <% } else { %>
                                        <span class="badge bg-light text-secondary border font-monospace">Upload do Sistema</span>
                                    <% } %>
                                </td>
                                <td>
                                    <code class="text-primary bg-light px-2 py-1 rounded small"><%= arq.caminho %></code>
                                </td>
                                <td>
                                    <% if (arq.tamanho) { %>
                                        <%= (arq.tamanho / 1024).toFixed(1) %> KB
                                    <% } else { %>
                                        <span class="text-muted">—</span>
                                    <% } %>
                                </td>
                                <td>
                                    <span class="badge bg-secondary-subtle text-dark border"><%= arq.tipoMime || 'application/octet-stream' %></span>
                                </td>
                                <td class="text-muted">
                                    <%= new Date(arq.criadoEm).toLocaleString('pt-BR') %>
                                </td>
                                <td class="text-end">
                                    <a href="<%= arq.caminho %>" target="_blank" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                        <i class="fa-solid fa-arrow-up-right-from-square me-1"></i> Abrir
                                    </a>
                                </td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-folder-open fs-2 text-muted mb-2 d-block"></i>
                                Nenhum arquivo registrado ainda na tabela <code>arquivos</code> do PostgreSQL.<br>
                                Realize um novo cadastro com foto ou adicione um logotipo de parceiro para registrar automaticamente.
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<%- include('../layout/footer') %>
