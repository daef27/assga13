<%- include('../layout/header') %>

<div class="container py-2">
    <%- include('nav_tabs') %>

    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <span class="badge bg-primary text-white px-3 py-1 rounded-pill fw-bold text-uppercase small">Atendimento</span>
                <h4 class="fw-bold text-primary mb-1 mt-1"><i class="fa-solid fa-comments me-2"></i>Mensagens Recebidas • Fale Conosco</h4>
                <p class="text-muted small mb-0">Mensagens enviadas por associados, atletas e cidadãos através do formulário público de contato.</p>
            </div>
            <div>
                <span class="badge bg-light text-primary border px-3 py-2 rounded-pill fw-bold">
                    <%= mensagensContato.length %> Mensagens
                </span>
            </div>
        </div>
    </div>

    <!-- Tabela de Mensagens -->
    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
        <% if (mensagensContato && mensagensContato.length > 0) { %>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Data</th>
                            <th>Remetente</th>
                            <th>Contato</th>
                            <th>Mensagem</th>
                            <th>Status</th>
                            <th class="text-end">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% mensagensContato.forEach(function(m) { %>
                        <tr>
                            <td class="small text-muted text-nowrap"><%= m.data_envio %></td>
                            <td>
                                <div class="fw-bold text-dark"><%= m.nome %></div>
                            </td>
                            <td>
                                <div><a href="mailto:<%= m.email %>" class="small text-decoration-none"><%= m.email %></a></div>
                                <div>
                                    <a href="https://wa.me/<%= m.telefone.replace(/\D/g, '') %>" target="_blank" class="small text-success fw-semibold text-decoration-none">
                                        <i class="fa-brands fa-whatsapp me-1"></i><%= m.telefone %>
                                    </a>
                                </div>
                            </td>
                            <td style="max-width: 360px;">
                                <div class="small text-muted"><%= m.mensagem %></div>
                            </td>
                            <td>
                                <span class="badge <%= m.status === 'Respondida' ? 'bg-success' : (m.status === 'Pendente' ? 'bg-warning text-dark' : 'bg-secondary') %>">
                                    <%= m.status %>
                                </span>
                            </td>
                            <td class="text-end text-nowrap">
                                <form method="post" action="/admin/contatos/<%= m.id %>/status" class="d-inline-block me-1">
                                    <select name="status" class="form-select form-select-sm d-inline-block w-auto" onchange="this.form.submit()">
                                        <option value="Pendente" <%= m.status === 'Pendente' ? 'selected' : '' %>>Pendente</option>
                                        <option value="Respondida" <%= m.status === 'Respondida' ? 'selected' : '' %>>Respondida</option>
                                        <option value="Arquivada" <%= m.status === 'Arquivada' ? 'selected' : '' %>>Arquivada</option>
                                    </select>
                                </form>
                                <form method="post" action="/admin/contatos/<%= m.id %>/excluir" class="d-inline-block" onsubmit="return confirm('Excluir esta mensagem de contato?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill" title="Excluir">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <div class="text-center py-5 text-muted">
                <i class="fa-solid fa-inbox display-5 mb-2 opacity-50"></i>
                <p class="mb-0">Nenhuma mensagem recebida até o momento.</p>
            </div>
        <% } %>
    </div>
</div>

<%- include('../layout/footer') %>
